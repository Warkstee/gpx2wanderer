# Encryption key for credentials (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-key-here

# Valhalla routing engine
VALHALLA_URL=http://localhost:8002

# Wanderer instance
WANDERER_URL=http://localhost:3000

# Database path
DATABASE_PATH=./data/gpx2wanderer.db

# Waypoint generation defaults
DEFAULT_EPSILON_METERS=30
DEFAULT_TOLERANCE_METERS=50
DEFAULT_MAX_ITERATIONS=10
