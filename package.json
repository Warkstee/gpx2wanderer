{
  "name": "gpx2wanderer",
  "version": "0.1.0",
  "description": "Algorithmic waypoint generation for GPX tracks to Wanderer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gpx2wanderer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "smoke-test:komoot-download": "node dist/smoke-test-komoot-download.js"
  },
  "keywords": [
    "gpx",
    "wanderer",
    "waypoints",
    "valhalla",
    "routing"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.7.5",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
